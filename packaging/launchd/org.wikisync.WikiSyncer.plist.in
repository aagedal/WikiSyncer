<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.wikisync.WikiSyncer</string>

    <key>ProgramArguments</key>
    <array>
        <string>@WIKISYNCD@</string>
        <string>--library</string>
        <string>@LIBRARY@</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>@LOG_DIRECTORY@/wikisyncd.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIRECTORY@/wikisyncd-error.log</string>
</dict>
</plist>
